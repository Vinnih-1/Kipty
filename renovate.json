{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "includePaths": [
    "app/build.gradle.kts",
    "gradle/libs.versions.toml"
  ],
  "ignorePaths": [
    "whisper_cpp/**",
    "models/**"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "registryUrls": [
        "https://repo.maven.apache.org/maven2",
        "https://maven.google.com",
        "https://plugins.gradle.org/m2"
      ]
    },
    {
      "matchPackagePrefixes": ["androidx.compose"],
      "groupName": "Jetpack Compose"
    },
    {
      "matchPackagePrefixes": ["androidx.room"],
      "groupName": "Room"
    },
    {
      "matchPackagePrefixes": ["com.google.dagger"],
      "groupName": "Hilt"
    },
    {
      "matchPackagePrefixes": ["org.jetbrains.kotlin"],
      "groupName": "Kotlin"
    },
    {
      "matchPackagePrefixes": ["androidx."],
      "groupName": "AndroidX"
    }
  ]
}
